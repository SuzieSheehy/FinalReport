@article{szwacki_aromatic_2009,
	title = {Aromatic {Borozene}},
	volume = {4},
	issn = {1556-276X},
	url = {https://link.springer.com/10.1007/s11671-009-9362-2},
	doi = {10.1007/s11671-009-9362-2},
	abstract = {Based on our comprehensive theoretical investigation and known experimental results for small boron clusters, we predict the existence of a novel aromatic inorganic molecule, B12H6. This molecule, which we refer to as borozene, has remarkably similar properties to the well-known benzene. Borozene is planar, possesses a large ﬁrst excitation energy, D3h symmetry, and more importantly is aromatic. Furthermore, the calculated anisotropy of the magnetic susceptibility of borozene is three times larger in absolute value than for benzene. Finally, we show that borozene molecules may be fused together to give larger aromatic compounds with even larger anisotropic susceptibilities.},
	language = {en},
